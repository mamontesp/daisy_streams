# Snowflake Source Configuration (Zero Password: only key_pair [prod] or externalbrowser [dev] supported)
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=DAISY_SERVICE_USER
SNOWFLAKE_AUTHENTICATOR=key_pair  # "key_pair" for headless prod/containers | "externalbrowser" for local dev
SNOWFLAKE_PRIVATE_KEY_PATH=/secrets/rsa_key.p8  # Path to PKCS#8 PEM private key
# SNOWFLAKE_PRIVATE_KEY_CONTENT=  # Optional: raw PEM string or injected env secret
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=  # Optional passphrase if private key is encrypted
SNOWFLAKE_ROLE=DAISY_INGESTION_ROLE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=daisy_streams
SNOWFLAKE_SCHEMA=ingestion
SNOWFLAKE_TABLE=ORDERS
SNOWFLAKE_WATERMARK_COLUMN=O_ORDERDATE
SNOWFLAKE_ENTITY_KEY_COLUMN=O_ORDERKEY

# Ingestion / Sync Settings
SYNC_BATCH_SIZE=10000
SYNC_INITIAL_BOUND=50000
SYNC_STATE_STORAGE=garage  # garage | local | minio
SYNC_STATE_FILE_PATH=.daisy_sync_state.json

# Garage S3 Object Storage State Persistence Configuration
GARAGE_ENDPOINT=localhost:3900
GARAGE_ACCESS_KEY=GKdaisystreamskey01234
GARAGE_SECRET_KEY=daisystreamssecretkey0123456789abcdef0123456789abcdef
GARAGE_BUCKET=daisy-state
GARAGE_REGION=garage
GARAGE_SECURE=false

# Apache Kafka Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=switch.orders.events
KAFKA_CONSUMER_GROUP=daisy-streams-consumer-group
KAFKA_CLIENT_ID=daisy-streams-adapter

# Kafka UI Dashboard Configuration
KAFKA_UI_PORT=8080

# PostgreSQL Sink Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=daisy_streams
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# FastAPI Inspection Service
API_HOST=0.0.0.0
API_PORT=8000

# Observability & Structured S3 Log Storage
LOG_LEVEL=INFO
ENVIRONMENT=development
GARAGE_LOGS_BUCKET=daisy-logs
LOG_STORE_TO_S3=true
LOG_S3_FLUSH_INTERVAL_SEC=30
LOG_S3_BUFFER_SIZE=50

