# Snowflake Source Configuration
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SNOWFLAKE_SAMPLE_DATA
SNOWFLAKE_SCHEMA=TPCH_SF1
SNOWFLAKE_TABLE=ORDERS

# Ingestion / Sync Settings
SYNC_BATCH_SIZE=10000
SYNC_INITIAL_BOUND=50000
SYNC_STATE_STORAGE=postgres  # postgres | local

# Redpanda / Kafka Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=switch.orders.events
KAFKA_CONSUMER_GROUP=daisy-streams-consumer-group
KAFKA_CLIENT_ID=daisy-streams-adapter

# PostgreSQL Sink Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=daisy_streams
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# FastAPI Inspection Service
API_HOST=0.0.0.0
API_PORT=8000

# Observability
LOG_LEVEL=INFO
ENVIRONMENT=development
